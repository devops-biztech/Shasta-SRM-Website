---
// Fine-line cutaway of a wood-fired steam plant. Illustrative, not SRM's exact equipment.
---
<figure class="cutaway" data-cutaway>
  <svg viewBox="0 0 560 270" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="cut-title">
    <title id="cut-title">Cutaway: wood chips ride a conveyor into the boiler, steam runs to the turbine, and the generator sends power to the grid.</title>
    <path pathLength="1" class="d" d="M10 236 H550" stroke-width="1"/>
    <path pathLength="1" class="d" d="M22 236 Q58 176 104 236"/>
    <path pathLength="1" class="d" d="M88 222 L168 120 M100 230 L178 130"/>
    <rect pathLength="1" class="d" x="168" y="74" width="96" height="162" rx="3"/>
    <path pathLength="1" class="d" d="M184 92 V200 M198 92 V200 M212 92 V200 M226 92 V200 M240 92 V200 M254 92 V200" stroke-width="1"/>
    <path d="M216 226 C228 212 232 202 226 190 C236 196 244 208 238 222 C246 216 246 206 244 200 C254 210 254 226 240 232 H196 C186 226 188 212 198 204 C198 214 204 220 216 226 Z" fill="var(--boil)" stroke="none"/>
    <path pathLength="1" class="d" id="pc-steam" d="M216 74 V44 H370 V112" stroke="var(--steam)" stroke-width="3"/>
    <path pathLength="1" class="d" d="M346 112 L430 126 V186 L346 200 Z"/>
    <path pathLength="1" class="d" d="M362 126 V186 M378 124 V188 M394 126 V186 M410 128 V184" stroke-width="1"/>
    <rect pathLength="1" class="d" x="440" y="128" width="62" height="56" rx="4"/>
    <path pathLength="1" class="d" d="M452 140 Q471 156 490 140 M452 156 Q471 172 490 156 M452 172 Q471 188 490 172" stroke-width="1"/>
    <path pathLength="1" class="d" d="M388 200 V236" stroke-width="1"/>
    <path pathLength="1" class="d" id="pc-power" d="M502 156 H532 V96 H552" stroke="var(--gold)" stroke-width="3"/>
    <path pathLength="1" class="d" d="M524 236 L536 96 L548 236 M528 190 H544 M530 150 H542" stroke-width="1"/>
    <g stroke="none" class="lab">
      <text x="62" y="256" text-anchor="middle">Fuel yard</text>
      <text x="126" y="150" text-anchor="end">Conveyor</text>
      <text class="t" x="150" y="96" text-anchor="end">Boiler</text>
      <text x="293" y="34" text-anchor="middle">High-pressure steam</text>
      <text class="t" x="388" y="222" text-anchor="middle">Turbine</text>
      <text class="t" x="471" y="206" text-anchor="middle">Generator</text>
      <text x="536" y="84" text-anchor="middle">To grid</text>
    </g>
    <path id="pc-fuel" d="M62 206 L96 222 L172 128 L200 180" stroke="none"/>
    <g stroke="none" class="moving">
      <rect width="7" height="5" fill="var(--fuel)"><animateMotion dur="3s" repeatCount="indefinite" rotate="auto"><mpath href="#pc-fuel"/></animateMotion></rect>
      <rect width="7" height="5" fill="var(--fuel)"><animateMotion dur="3s" begin="1s" repeatCount="indefinite" rotate="auto"><mpath href="#pc-fuel"/></animateMotion></rect>
      <rect width="7" height="5" fill="#a9865c"><animateMotion dur="3s" begin="2s" repeatCount="indefinite" rotate="auto"><mpath href="#pc-fuel"/></animateMotion></rect>
      <circle r="5" fill="var(--steam)" opacity=".7"><animateMotion dur="2.2s" repeatCount="indefinite"><mpath href="#pc-steam"/></animateMotion></circle>
      <circle r="5" fill="var(--steam)" opacity=".7"><animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite"><mpath href="#pc-steam"/></animateMotion></circle>
      <circle r="4" fill="var(--gold)"><animateMotion dur="1s" repeatCount="indefinite"><mpath href="#pc-power"/></animateMotion></circle>
      <circle r="4" fill="var(--gold)"><animateMotion dur="1s" begin=".5s" repeatCount="indefinite"><mpath href="#pc-power"/></animateMotion></circle>
    </g>
  </svg>
  <figcaption>Illustration of a wood-fired steam plant. Equipment is simplified.</figcaption>
</figure>

<style>
  .cutaway { margin: 0; padding: clamp(18px, 3vw, 32px); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); display: grid; gap: 12px; color: var(--ink); }
  svg { width: 100%; height: auto; }
  .d { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cutaway.seen .d { stroke-dashoffset: 0; transition: stroke-dashoffset 1.8s cubic-bezier(.6,.1,.2,1); }
  .lab text { font: 600 12px var(--body); fill: var(--muted); }
  .lab text.t { font-weight: 700; fill: var(--ink); font-size: 13px; }
  figcaption { color: var(--muted); font-size: .88rem; }
  @media (prefers-reduced-motion: reduce) { .d { stroke-dashoffset: 0; } .moving { display: none; } }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-cutaway]');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('seen'); io.unobserve(e.target); } }), { threshold: 0.3 });
  els.forEach((el) => io.observe(el));
</script>
