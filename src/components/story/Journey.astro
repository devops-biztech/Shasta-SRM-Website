---
import Icon from '../Icon.astro';
import { steps, flowColor } from '../../data/story';
import { STORY_ENGINE, SHOW_VIEW_SWITCH, SHOW_LIGHT_PREVIEW } from '../../config';
---
<section class="journey" id="journey" data-journey data-engine={STORY_ENGINE} aria-labelledby="journey-title">
  <div class="stage" data-stage>
    <div class="engine" data-engine-host aria-hidden="true"></div>
    <div class="labels" data-labels aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>
    <p class="loading" data-loading role="status">Building the model…</p>

    <div class="hero-copy" data-hero>
      <h1 id="journey-title">Wildfire fuel in. <span>Clean power out.</span></h1>
      <p class="sub" data-sub>We turn thinnings from the forests around Mt.&nbsp;Shasta and Lassen into renewable electricity for about <b>62,600 homes</b>.</p>
      <div class="cluster ctas">
        <a class="btn btn-primary" href="/careers/">Join the crew</a>
        <a class="btn" href="#step-1" data-start>Follow the journey <Icon name="arrow-down" /></a>
      </div>
      <p class="sun-line" data-now aria-live="off">Anderson, California</p>
    </div>

    <div class="panel" data-panel aria-hidden="true">
      <h2 class="swap" data-title>{steps[0].title}</h2>
      <p class="swap" data-text>{steps[0].text}</p>
      <p class="figure" data-figure hidden></p>
      <div class="progress">
        <div class="rail" data-rail>
          {steps.map((s, i) => <button type="button" style={`--rc:${flowColor[s.flow]}`} data-jump={i} tabindex="-1"><span class="visually-hidden">Step {i + 1}: {s.title}</span></button>)}
        </div>
        <span class="count" data-count>1/8</span>
      </div>
    </div>

    <div class="legend">
      <span class="keys"><span class="key"><i style="background:var(--fuel)"></i>Wood waste</span><span class="key"><i style="background:var(--gold)"></i>Electricity</span></span>
      {/* Segmented switches on desktop; on phones each collapses to a pill showing the current choice that opens the options. */}
      {SHOW_VIEW_SWITCH && (
        <span class="pick" data-pick>
          <button type="button" class="pick-btn" aria-expanded="false" aria-controls="pick-view" data-pick-btn><span class="visually-hidden">View: </span><span data-pick-label>3D model</span><Icon name="chevron-up" size={16} /></button>
          <span class="seg" id="pick-view" role="group" aria-label="Choose view">
            <button type="button" data-view="diorama" aria-pressed="false">3D model</button>
            <button type="button" data-view="contour" aria-pressed="false">Contour map</button>
          </span>
        </span>
      )}
      {SHOW_LIGHT_PREVIEW && (
        <span class="pick" data-pick>
          <button type="button" class="pick-btn" aria-expanded="false" aria-controls="pick-light" data-pick-btn><span class="visually-hidden">Light: </span><span data-pick-label>Live</span><Icon name="chevron-up" size={16} /></button>
          <span class="seg" id="pick-light" role="group" aria-label="Preview the light">
            <button type="button" data-light="live" aria-pressed="true">Live</button>
            <button type="button" data-light="day" aria-pressed="false">Day</button>
            <button type="button" data-light="golden" aria-pressed="false">Golden hour</button>
            <button type="button" data-light="night" aria-pressed="false">Night</button>
          </span>
        </span>
      )}
    </div>
    <p class="cue" data-cue aria-hidden="true"><i></i>Scroll to follow a load of wood</p>
  </div>

  <!-- The story as plain text: read by screen readers and search engines, and shown if the model can't run. -->
  <ol class="steps-text" data-steps-text>
    {steps.map((s, i) => (
      <li id={`step-${i + 1}`}>
        <h2>{s.title}</h2>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .journey { position: relative; height: 1000vh; }
  /* --safe-bottom keeps bottom-anchored UI clear of floating browser toolbars and the home indicator */
  .stage { --safe-bottom: max(22px, calc(env(safe-area-inset-bottom, 0px) + 12px)); position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bot) 62%, var(--bg) 100%); transition: background .8s var(--ease-out); }
  .engine, .engine :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 88%, transparent) 0%, color-mix(in srgb, var(--bg) 55%, transparent) 28%, transparent 50%); }
  .loading { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; color: var(--muted); font-weight: 600; pointer-events: none; transition: opacity .6s; }
  .loading.done { opacity: 0; }

  .hero-copy { position: absolute; z-index: 3; left: var(--gutter); top: clamp(128px, 19vh, 190px); width: min(46vw, 660px); display: grid; gap: 22px; }
  .hero-copy h1 { font-size: clamp(2.75rem, 5.3vw, 5.4rem); }
  .hero-copy h1 span { display: block; color: var(--gold); }
  .sub { font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: var(--muted); max-width: 44ch; }
  .sub :global(b) { color: var(--ink); font-weight: 600; }
  .ctas { --gap: 12px; margin-top: 4px; }
  /* The outline button can land on dark terrain (phones stack the buttons low); give it a frosted backing */
  .ctas .btn:not(.btn-primary) { background: color-mix(in srgb, var(--surface) 78%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .sun-line { font-size: .95rem; font-weight: 600; color: var(--muted); display: flex; align-items: center; gap: 10px; }
  .sun-line::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--gold-glow); box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold-glow) 25%, transparent); flex: none; }

  .panel { position: absolute; z-index: 3; left: var(--gutter); top: 50%; width: min(410px, calc(100% - 2 * var(--gutter))); transform: translateY(-50%); background: color-mix(in srgb, var(--surface) 86%, transparent); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2); border: 1px solid var(--line); border-radius: 22px; padding: 28px 28px 20px; display: grid; gap: 12px; box-shadow: var(--shadow-2); opacity: 0; visibility: hidden; transition: opacity .5s var(--ease-out), visibility .5s; }
  .panel.on { opacity: 1; visibility: visible; }
  .panel h2 { font-size: clamp(1.9rem, 3vw, 2.75rem); }
  .panel p { color: var(--muted); }
  .swap.enter { animation: enter .5s var(--ease-out) both; }
  p.swap.enter { animation-delay: .05s; }
  @keyframes enter { from { opacity: 0; transform: translateY(10px); filter: blur(4px); } }
  .figure { font: 800 2.6rem/1 var(--display); letter-spacing: -.03em; color: var(--gold); }
  .figure :global(small) { display: block; font: 600 .9rem/1.3 var(--body); letter-spacing: 0; color: var(--muted); margin-top: 6px; }
  .progress { display: flex; align-items: center; gap: 14px; margin-top: 6px; }
  .rail { display: flex; gap: 5px; flex: 1; }
  .rail button { flex: 1; height: 24px; border: 0; background: none; padding: 0; cursor: pointer; position: relative; }
  .rail button::before { content: ""; position: absolute; inset: 8px 0 auto; height: 8px; border-radius: 4px; background: var(--line); transform: scaleY(.5); transition: background-color .3s, transform .3s var(--ease-out); }
  .rail button.done::before, .rail button.now::before { background: var(--rc); }
  .rail button.now::before { transform: scaleY(1); }
  .count { font-weight: 700; font-size: .9rem; color: var(--muted); min-width: 2.6em; text-align: right; }

  .legend { position: absolute; z-index: 3; right: var(--gutter); bottom: var(--safe-bottom); display: flex; gap: 10px 12px; flex-wrap: wrap; align-items: center; justify-content: flex-end; font-size: .85rem; color: var(--ink); max-width: calc(100% - 2 * var(--gutter)); }
  .keys { display: inline-flex; gap: 14px; padding: 8px 14px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 86%, transparent); border: 1px solid var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); font-weight: 600; }
  .key { display: inline-flex; align-items: center; gap: 7px; }
  .key i { width: 18px; height: 3px; border-radius: 3px; }
  .seg { display: inline-flex; gap: 2px; padding: 4px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 86%, transparent); border: 1px solid var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .seg button { font: 600 .8rem/1 var(--body); color: var(--muted); background: none; border: 0; border-radius: 999px; padding: 8px 11px; cursor: pointer; transition: background-color .2s, color .2s; }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
  .pick { position: relative; display: inline-flex; }
  .pick-btn { display: none; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px 0 18px; border-radius: 999px; border: 1px solid var(--line-strong); background: color-mix(in srgb, var(--surface) 88%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: var(--ink); font: 700 .9rem/1 var(--body); cursor: pointer; box-shadow: var(--shadow-1); white-space: nowrap; }
  .pick-btn :global(svg) { color: var(--muted); transition: transform .25s var(--ease-out); }
  .pick-btn[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  @keyframes pick-in { from { opacity: 0; transform: translateY(6px) scale(.97); } }
  .cue { position: absolute; z-index: 3; left: var(--gutter); bottom: calc(var(--safe-bottom) + 4px); font-size: .85rem; font-weight: 600; color: var(--muted); display: flex; gap: 10px; align-items: center; }
  .cue i { width: 20px; height: 32px; border: 1.5px solid currentColor; border-radius: 12px; position: relative; }
  .cue i::after { content: ""; position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: currentColor; animation: cue 1.8s var(--ease-out) infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 80% { transform: translateY(10px); opacity: 0; } 100% { opacity: 0; } }

  /* 3D labels */
  .labels :global(.lbl) { position: absolute; left: 0; top: 0; white-space: nowrap; font: 700 .875rem/1.2 var(--body); color: var(--ink); text-shadow: 0 0 2px var(--surface), 0 0 2px var(--surface), 0 0 3px var(--surface), 0 0 8px var(--surface); will-change: transform, opacity; }
  .labels :global(.lbl small) { display: block; font-weight: 600; font-size: .75rem; color: var(--ink); }
  .labels :global(.lbl.minor) { font-weight: 600; font-size: .8rem; }
  .labels :global(.lbl::before) { content: ""; position: absolute; left: -12px; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .labels :global(.lbl.part) { font-size: .78rem; padding: 5px 10px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 90%, transparent); border: 1px solid var(--line); text-shadow: none; box-shadow: var(--shadow-1); }
  .labels :global(.lbl.part::before) { display: none; }
  /* contour-map plant cutaway */
  .labels :global(.inset) { position: absolute; left: calc(var(--gutter) + 442px); top: 50%; width: min(620px, calc(100% - 2 * var(--gutter) - 442px)); transform: translateY(-50%) scale(.96); opacity: 0; transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); background: color-mix(in srgb, var(--surface) 90%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: 22px; padding: 16px 18px 12px; color: var(--ink); box-shadow: var(--shadow-2); }
  .labels :global(.inset.show) { opacity: 1; transform: translateY(-50%) scale(1); }
  .labels :global(.inset-cap) { display: flex; justify-content: space-between; gap: 10px; font-size: .8rem; color: var(--muted); font-weight: 600; flex-wrap: wrap; }
  .labels :global(.inset svg) { width: 100%; height: auto; }
  .labels :global(.inset .draw) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.6s cubic-bezier(.6,.1,.2,1); }
  .labels :global(.inset.show .draw) { stroke-dashoffset: 0; }
  .labels :global(.inset .hot) { opacity: .45; transition: opacity .5s; }
  .labels :global(.inset[data-focus="boiler"] .h-boiler), .labels :global(.inset[data-focus="turbine"] .h-turbine) { opacity: 1; }
  .labels :global(.inset text) { font: 600 12px var(--body); fill: var(--muted); }
  .labels :global(.inset text.t) { font-weight: 700; fill: var(--ink); font-size: 13px; }

  .steps-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; }

  /* Fallback: no engine. The journey becomes a readable list. */
  .journey.static { height: auto; }
  .journey.static .stage { position: relative; height: auto; min-height: 88svh; }
  .journey.static .panel, .journey.static .legend, .journey.static .cue, .journey.static .loading { display: none; }
  .journey.static .steps-text { position: static; width: auto; height: auto; clip: auto; overflow: visible; list-style: none; padding: 48px var(--gutter) 96px; margin: 0 auto; max-width: var(--max); display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); counter-reset: s; }
  .journey.static .steps-text li { counter-increment: s; display: grid; gap: 8px; }
  .journey.static .steps-text li::before { content: counter(s); font: 800 1rem/1 var(--display); color: var(--gold); }
  .journey.static .steps-text p { color: var(--muted); }

  @media (max-width: 860px) {
    .stage { --safe-bottom: max(36px, calc(env(safe-area-inset-bottom, 0px) + 24px)); }
    .scrim { background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 88%, transparent) 0%, color-mix(in srgb, var(--bg) 55%, transparent) 42%, transparent 64%); }
    .journey.stepping .scrim { background: linear-gradient(0deg, color-mix(in srgb, var(--bg) 88%, transparent) 0%, transparent 52%); }
    .hero-copy { top: 92px; gap: 14px; }
    .panel { top: auto; bottom: var(--safe-bottom); max-height: calc(100% - 84px - var(--safe-bottom)); overflow-y: auto; transform: none; padding: 20px 20px 14px; gap: 8px; border-radius: 18px; }
    .panel h2 { font-size: 1.75rem; }
    .panel p { font-size: 1rem; }
    .figure { font-size: 1.9rem; }
    .keys, .cue { display: none; }
    .journey.stepping .legend { display: none; }
    .labels :global(.lbl.minor) { display: none; }
    .labels :global(.inset) { top: 34%; left: 50%; width: min(620px, 92vw); transform: translate(-50%, -50%) scale(.96); }
    .labels :global(.inset.show) { transform: translate(-50%, -50%) scale(1); }
    .hero-copy { width: calc(100% - 2 * var(--gutter)); }
    .hero-copy h1 { font-size: clamp(2.2rem, 10.5vw, 3.6rem); }
    /* One swipeable row, so the switches never climb into the hero buttons */
    .legend { left: var(--gutter); right: var(--gutter); bottom: var(--safe-bottom); flex-wrap: nowrap; justify-content: flex-start; max-width: none; }
    /* Each switch becomes a pill labelled with the current choice; tapping it opens the options above */
    .pick-btn { display: inline-flex; }
    .pick .seg { display: none; position: absolute; bottom: calc(100% + 8px); left: 0; flex-direction: column; min-width: max(100%, 168px); padding: 6px; gap: 2px; border-radius: 20px; background: color-mix(in srgb, var(--surface) 94%, transparent); box-shadow: var(--shadow-2); }
    .pick:last-child .seg { left: auto; right: 0; }
    .pick.open .seg { display: flex; animation: pick-in .25s var(--ease-out); }
    .pick .seg button { text-align: left; font-size: .95rem; min-height: 44px; padding: 10px 16px; border-radius: 14px; }
  }
  @media (pointer: coarse) {
    .seg button { min-height: 40px; padding-inline: 13px; }
  }
  /* Short portrait phones: tighten the hero so it clears the legend */
  @media (max-width: 860px) and (max-height: 700px) {
    .hero-copy { top: 84px; }
    .sub { font-size: 1rem; }
    .sun-line { display: none; }
  }
  /* Phones on their side: back to the side-by-side desktop arrangement, scaled to the short screen */
  @media (max-width: 960px) and (max-height: 500px) and (orientation: landscape) {
    .stage { --safe-bottom: max(16px, calc(env(safe-area-inset-bottom, 0px) + 10px)); --side: max(var(--gutter), calc(env(safe-area-inset-left, 0px) + 12px)); }
    .hero-copy, .panel { left: var(--side); }
    .scrim { background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 90%, transparent) 0%, color-mix(in srgb, var(--bg) 60%, transparent) 40%, transparent 62%); }
    .journey.stepping .scrim { background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, transparent 50%); }
    .hero-copy { top: 78px; width: min(52%, 500px); gap: 12px; }
    .hero-copy h1 { font-size: clamp(1.9rem, 8.5vh, 2.6rem); }
    .sub { font-size: .95rem; line-height: 1.5; }
    .sun-line { display: none; }
    .legend { left: auto; right: var(--gutter); width: auto; max-width: calc(48% - var(--gutter)); }
    .panel { top: auto; bottom: var(--safe-bottom); transform: none; width: min(400px, 50%); max-height: calc(100% - 76px - var(--safe-bottom)); overflow-y: auto; padding: 18px 20px 12px; gap: 8px; }
    .panel h2 { font-size: 1.6rem; }
    .figure { font-size: 1.7rem; }
    .panel p { font-size: .95rem; }
  }
</style>

<script>
  import { mountJourney } from '../../scripts/journey';
  mountJourney(document.querySelector<HTMLElement>('[data-journey]')!);

  // Phone pickers: the pill shows whichever option is pressed; journey.ts owns the pressed state.
  const picks = [...document.querySelectorAll<HTMLElement>('[data-pick]')];
  const setOpen = (pick: HTMLElement, open: boolean) => {
    pick.classList.toggle('open', open);
    pick.querySelector('[data-pick-btn]')!.setAttribute('aria-expanded', String(open));
  };
  picks.forEach((pick) => {
    const btn = pick.querySelector<HTMLButtonElement>('[data-pick-btn]')!;
    const label = pick.querySelector<HTMLElement>('[data-pick-label]')!;
    const seg = pick.querySelector<HTMLElement>('.seg')!;
    const sync = () => { label.textContent = seg.querySelector('[aria-pressed="true"]')?.textContent ?? label.textContent; };
    new MutationObserver(sync).observe(seg, { subtree: true, attributeFilter: ['aria-pressed'] });
    sync();
    btn.addEventListener('click', () => {
      const open = !pick.classList.contains('open');
      picks.forEach((p) => setOpen(p, p === pick && open));
      if (open) seg.querySelector<HTMLElement>('[aria-pressed="true"]')?.focus();
    });
    seg.addEventListener('click', (e) => { if ((e.target as Element).closest('button')) { setOpen(pick, false); btn.focus(); } });
  });
  document.addEventListener('click', (e) => { picks.forEach((p) => { if (!p.contains(e.target as Node)) setOpen(p, false); }); });
  addEventListener('scroll', () => picks.forEach((p) => setOpen(p, false)), { passive: true });
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = picks.find((p) => p.classList.contains('open'));
    if (open) { setOpen(open, false); open.querySelector<HTMLElement>('[data-pick-btn]')!.focus(); }
  });
</script>
