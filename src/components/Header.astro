---
import Icon from './Icon.astro';
import { nav, org } from '../data/site';
const path = Astro.url.pathname;
const here = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href="/" aria-label={`${org.name}, home`}>
      <img src="/brand/logo-250x140.png" width="89" height="50" alt="" />
    </a>
    <nav class="primary" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn btn-primary btn-small apply" href="/careers/">Apply now</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <Icon name="menu" size={22} class="i-open" /><Icon name="close" size={22} class="i-close" />
    </button>
  </div>
  <div class="mobile" id="mobile-menu" hidden data-menu>
    <nav aria-label="Mobile">
      {nav.map((n) => <a href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}<Icon name="arrow-right" /></a>)}
      <a href="/safety/">Safety<Icon name="arrow-right" /></a>
      <a href="/contact/">Contact<Icon name="arrow-right" /></a>
    </nav>
    <a class="btn btn-primary" href="/careers/">See open positions</a>
    <a class="call" href={`tel:${org.phone.main}`}><Icon name="phone" />{org.phone.main}</a>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 50; padding-top: env(safe-area-inset-top, 0px); transition: transform .45s var(--ease-out), background-color .3s, box-shadow .3s; }
  .site-header.solid { background: var(--bg); box-shadow: 0 1px 0 var(--line); }
  .site-header.away { transform: translateY(calc(-100% - 4px)); }
  .bar { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 32px); padding: 12px var(--gutter); max-width: 1440px; margin-inline: auto; }
  .brand img { height: 46px; width: auto; background: #fff; border-radius: 999px; padding: 3px 10px; box-shadow: 0 6px 18px -10px rgba(0,0,0,.45); }
  .primary { display: flex; gap: clamp(14px, 2vw, 26px); font-weight: 600; font-size: .98rem; }
  .primary a { text-decoration: none; padding: 8px 0; position: relative; }
  .primary a::after { content: ""; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; border-radius: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease-out); }
  .primary a:hover::after, .primary a[aria-current="page"]::after { transform: scaleX(1); }
  .apply { margin-left: auto; }
  .menu-btn { display: none; margin-left: 8px; width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink); place-items: center; cursor: pointer; }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded="true"] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded="true"] :global(.i-close) { display: block; }
  .mobile { padding: 8px var(--gutter) calc(24px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 16px; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow-2); max-height: calc(100dvh - 70px - env(safe-area-inset-top, 0px)); overflow-y: auto; overscroll-behavior: contain; animation: menu-in .3s var(--ease-out); }
  .mobile[hidden] { display: none; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }
  .mobile nav { display: grid; }
  .mobile nav a { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); font: 700 1.35rem/1.1 var(--display); letter-spacing: -.02em; text-decoration: none; }
  .mobile nav a[aria-current="page"] { color: var(--fuel); }
  .mobile .btn { justify-content: center; }
  .call { display: inline-flex; gap: 10px; align-items: center; font-weight: 600; justify-self: center; }
  @media (max-width: 900px) {
    .primary { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 420px) { .apply { display: none; } .menu-btn { margin-left: auto; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  let lastY = scrollY;
  const onScroll = () => {
    const y = scrollY;
    header.classList.toggle('solid', y > 40);
    if (btn.getAttribute('aria-expanded') !== 'true') header.classList.toggle('away', y > 160 && y > lastY);
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open;
    // Lock the page behind the menu so a swipe scrolls the menu, not the story.
    document.documentElement.style.overflow = open ? 'hidden' : '';
    header.classList.toggle('solid', open || scrollY > 40);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  // Close on a tap outside the header, on any menu link (hash links don't navigate away), and when the desktop nav returns.
  document.addEventListener('click', (e) => { if (!menu.hidden && !header.contains(e.target as Node)) setOpen(false); });
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
