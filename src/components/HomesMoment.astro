---
// 6,260 dots, one per ten homes, spread across the full width and lit outward from the plant as the section scrolls past.
import { facts, fmt } from '../data/site';
const homes = facts.homesPowered.value;
---
<section class="homes" data-homes aria-labelledby="homes-title">
  <div class="sticky">
    <div class="wrap layout">
      <div class="copy">
        <h2 id="homes-title">This is what 55&nbsp;megawatts looks like.</h2>
        <p class="lede">Every dot is ten homes. Scroll and watch them light up, from our plant outward. That’s the power we make from wood that would otherwise be burned in the open or left in the woods to dry out.</p>
        <p class="count"><span data-lit>0</span><small>of {fmt(homes)} homes</small></p>
      </div>
      <div class="field">
        <canvas data-field role="img" aria-label={`A field of ${fmt(homes / 10)} dots, each standing for ten of the ${fmt(homes)} homes our plant can power.`}></canvas>
      </div>
    </div>
  </div>
</section>

<style>
  .homes { position: relative; height: 240vh; background: var(--bg); }
  .sticky { position: sticky; top: 0; min-height: 100svh; display: grid; align-items: center; padding-block: 88px 40px; }
  .layout { display: grid; gap: clamp(24px, 3.5vw, 44px); }
  .copy { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr) auto; gap: 16px clamp(28px, 4vw, 64px); align-items: end; }
  .copy h2 { max-width: 12ch; }
  .copy .lede { max-width: 46ch; }
  .count { font: 800 clamp(3rem, 5.4vw, 5rem)/1 var(--display); letter-spacing: -.04em; color: var(--gold); font-variant-numeric: tabular-nums; text-align: right; min-width: 6.2ch; }
  .count small { display: block; font: 600 1rem/1.4 var(--body); letter-spacing: 0; color: var(--muted); margin-top: 8px; }
  .field { width: 100%; min-width: 0; }
  .field canvas { display: block; width: 100%; height: auto; }
  @media (max-width: 1000px) {
    .copy { grid-template-columns: 1fr auto; }
    .copy h2 { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .homes { height: 210vh; }
    .sticky { padding-block: 72px 24px; }
    .copy { grid-template-columns: 1fr; }
    .count { text-align: left; }
  }
</style>

<script>
  // Whole-device-pixel dots, laid out as a wide panorama on large screens and a taller block on phones.
  const root = document.querySelector<HTMLElement>('[data-homes]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-field]')!;
  const litEl = root.querySelector<HTMLElement>('[data-lit]')!;
  const N = 6260, HOMES = 62600;
  const ctx = canvas.getContext('2d')!;

  let cols = 0, rows = 0, pitch = 6, lit = -1;
  let rank = new Uint16Array(N), gx = new Uint16Array(N), gy = new Uint16Array(N);

  // Light order: distance from the plant (lower left), roughened so it spreads like a town, not a circle.
  function layout(c: number) {
    cols = c; rows = Math.ceil(N / c);
    const d: number[] = [], order: number[] = [];
    let s = 7; const rnd = () => (s = (s * 9301 + 49297) % 233280) / 233280;
    const k = 101 / cols; // keep the noise the same size whatever the grid
    // fill rows from the bottom; the short top row ends before the far (top-right) corner
    gx = new Uint16Array(N); gy = new Uint16Array(N);
    for (let i = 0; i < N; i++) {
      const rb = Math.floor(i / cols);
      const x = i % cols, y = rows - 1 - rb;
      gx[i] = x; gy[i] = y;
      d[i] = Math.hypot(x - cols * 0.14, (y - rows * 0.8) * 1.15) * k * (0.8 + rnd() * 0.4) + Math.sin(x * k * 0.3) * Math.cos(y * k * 0.25) * 4;
      order.push(i);
    }
    order.sort((a, b) => d[a] - d[b]);
    rank = new Uint16Array(N); order.forEach((idx, r) => { rank[idx] = r; });
  }

  const sticky = root.querySelector<HTMLElement>('.sticky')!;
  function size() {
    const w = canvas.clientWidth;
    if (!w) return;
    // column counts chosen so the grid is nearly full: only 20 / 10 / 12 dots short, tucked into the far top-right corner
    let want = w >= 900 ? 157 : w >= 560 ? 110 : 98;
    // On short screens (phones on their side) widen the grid so the whole field fits on screen at once.
    // Measured from the small viewport height, so the phone's URL bar sliding in and out doesn't reshuffle the dots.
    const vh = parseFloat(getComputedStyle(sticky).minHeight) || innerHeight;
    const maxH = vh * 0.62;
    if ((w * Math.ceil(N / want)) / want > maxH) want = Math.min(N, Math.ceil(Math.sqrt((N * w) / maxH)));
    if (want !== cols) layout(want);
    const dpr = Math.min(3, devicePixelRatio || 1);
    pitch = Math.max(3, Math.floor((w * dpr) / cols));
    canvas.width = cols * pitch; canvas.height = rows * pitch;
    // When the section is taller than the screen (phones), pin it by its bottom edge so the dot field, not the heading, stays in view
    requestAnimationFrame(() => { sticky.style.top = `${Math.min(0, vh - sticky.offsetHeight)}px`; });
    lit = -1; update();
  }

  function paint(n: number) {
    const night = document.documentElement.classList.contains('night');
    const off = night ? '#22344f' : '#cdd7d1', on = night ? '#ffc94d' : '#c28a17';
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const r = Math.max(1, (pitch - 1.2) / 2);
    for (const [color, litPass] of [[off, false], [on, true]] as const) {
      ctx.fillStyle = color; ctx.beginPath();
      for (let i = 0; i < N; i++) {
        if ((rank[i] < n) !== litPass) continue;
        const cx = gx[i] * pitch + pitch / 2, cy = gy[i] * pitch + pitch / 2;
        ctx.moveTo(cx + r, cy); ctx.arc(cx, cy, r, 0, 6.2832);
      }
      ctx.fill();
    }
    litEl.textContent = Math.min(HOMES, n * 10).toLocaleString('en-US');
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function update() {
    if (!cols) return;
    const b = root.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (-b.top + innerHeight * 0.35) / (root.offsetHeight - innerHeight * 0.65)));
    const n = reduce ? N : Math.round(N * (1 - Math.pow(1 - p, 2)));
    if (n !== lit) { lit = n; paint(n); }
  }
  addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  new ResizeObserver(size).observe(canvas);
  new MutationObserver(() => { lit = -1; update(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
